# Server
AI_AGENT_HOST=0.0.0.0
AI_AGENT_PORT=8484
AI_AGENT_WORKERS=4
# Frontend origins allowed for credentialed requests. The Frappe dev server
# listens on port 8000; add your production frontend origins here as JSON.
AI_AGENT_CORS_ORIGINS=["http://localhost:8000"]

# LLM
# Default provider is Ollama running locally. Other supported providers:
# openai, anthropic, google. For non-Ollama providers, set AI_AGENT_LLM_API_KEY
# and adjust AI_AGENT_LLM_BASE_URL / AI_AGENT_LLM_MODEL accordingly.
AI_AGENT_LLM_PROVIDER=ollama
AI_AGENT_LLM_BASE_URL=http://localhost:11434
AI_AGENT_LLM_API_KEY=
AI_AGENT_LLM_MODEL=qwen3.5:9b
# Why: small local models (qwen3.5:9b at 0.7) occasionally emit malformed
# tool-call XML after 8+ calls; 0.2 tightens argument syntax while keeping
# prose readable.
AI_AGENT_LLM_TEMPERATURE=0.2
AI_AGENT_LLM_MAX_TOKENS=8192
# Why: Ollama defaults num_ctx to 2048, which is too small for system prompt
# + tool results + structured-block answer and causes silent mid-response
# truncation. Ignored for non-Ollama providers.
AI_AGENT_LLM_NUM_CTX=16384

# Agent
# Why: small models loop while exploring schema; the LangGraph default of 25
# trips often before they converge. 50 is enough headroom without letting a
# truly stuck agent run forever.
AI_AGENT_AGENT_RECURSION_LIMIT=50
# Why: per-sid rate limit on POST /api/v1/chat. slowapi syntax: "<count>/<period>".
AI_AGENT_AGENT_RATE_LIMIT=30/minute

# MCP — Streamable HTTP endpoint. frappe-mcp-server mounts /mcp on its
# main HTTP port (8080 per config.yaml). The +1 port (8081) is a separate
# raw-MCP-protocol server not used by this client.
AI_AGENT_MCP_SERVER_URL=http://localhost:8080/mcp

# Frappe (for chat history persistence — AI Chat Session / AI Chat Message DocTypes)
AI_AGENT_FRAPPE_URL=http://localhost:8000

# Observability
AI_AGENT_OTEL_ENDPOINT=
AI_AGENT_OTEL_SERVICE_NAME=frappe-ai-agent
AI_AGENT_LOG_LEVEL=info
AI_AGENT_LOG_FORMAT=json
