# Dev compose: MCP server + agent
# Copy to docker-compose.dev.yml and fill in the placeholder values.
#
# Prerequisites:
#   1. Build the MCP server image first:
#      git clone https://github.com/<org>/frappe-mcp-server && cd frappe-mcp-server
#      docker build -t frappe-mcp-server:local .
#   2. Generate an ERPNext API key/secret for your admin user:
#      bench --site <site> execute frappe.core.doctype.user.user.generate_keys --args '["Administrator"]'

services:
  mcp:
    image: frappe-mcp-server:local
    # Port mapping is "<host>:<container>". 1808x are the host ports
    # (mapped high so they don't collide with anything you already run
    # on 808x); 8080/8081 are the container ports the mcp service binds
    # internally. The agent talks to mcp via 8080 — that port hosts
    # BOTH the REST API and the Streamable-HTTP `/mcp` endpoint. 8081
    # is a separate raw-MCP-protocol server (not used by this client;
    # exposed only for tools that speak the protocol directly).
    ports:
      - "18080:8080"   # REST API + Streamable-HTTP /mcp (this is what the agent uses)
      - "18081:8081"   # Raw MCP protocol server (not used by frappe-ai-agent)
    volumes:
      - YOUR_MCP_CONFIG_PATH:/app/config.yaml:ro  # absolute path to your config.yaml
    environment:
      ERPNEXT_BASE_URL: YOUR_ERPNEXT_BASE_URL     # e.g. http://host.docker.internal:8080
      ERPNEXT_API_KEY: YOUR_ERPNEXT_API_KEY
      ERPNEXT_API_SECRET: YOUR_ERPNEXT_API_SECRET
    restart: unless-stopped

  agent:
    build:
      context: .
    ports:
      - "8484:8484"
    env_file: .env
    # Inside the compose network, the mcp service is reachable as "mcp"
    # on its container port (8080). .env.example documents
    # AI_AGENT_MCP_SERVER_URL=http://localhost:8080/mcp for laptop dev;
    # override here so the agent container talks to the mcp container
    # instead of trying to dial out of its own localhost. Likewise for
    # AI_AGENT_FRAPPE_URL if you run Frappe inside the compose net —
    # use the service name there, not localhost.
    environment:
      AI_AGENT_MCP_SERVER_URL: "http://mcp:8080/mcp"
      # AI_AGENT_FRAPPE_URL: "http://host.docker.internal:8000"  # if Frappe runs on the host
    restart: unless-stopped
